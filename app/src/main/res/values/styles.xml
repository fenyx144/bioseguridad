<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Bioseguridad" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
    </style>

    <style name="Theme.Bioseguridad.Login" parent="Theme.Bioseguridad.NoActionBar">
        <item name="colorPrimary">@color/azulino</item>
        <item name="colorPrimaryVariant">@color/purple_200</item>
    </style>

    <style name="Theme.Bioseguridad.NoActionBar" parent="Theme.Bioseguridad">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Bioseguridad.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Bioseguridad.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Theme.Bioseguridad.FullScreenDialog" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="estilo_Titulo_Fragment_black">
        <item name="android:textSize">20.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="estilo_celda">
        <item name="android:textSize">14.0sp</item>
        <item name="android:typeface">normal</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="estilo_celda_detalle">
        <item name="android:textSize">12.0sp</item>
        <item name="android:typeface">normal</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/negro</item>
    </style>
    <style name="estilo_contenido_Fragment_black">
        <item name="android:textSize">15.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="estilo_contenido_Fragment_brown">
        <item name="android:textSize">15.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/morado</item>
    </style>
    <style name="estilo_contenido_login">
        <item name="android:textSize">20.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/blanco</item>
    </style>
    <style name="estilo_contenido_login_black">
        <item name="android:textSize">20.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="estilo_labelFecha">
        <item name="android:textSize">15.0sp</item>
        <item name="android:typeface">normal</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/azulOscuro</item>
    </style>
    <style name="estilo_txt">
        <item name="android:textSize">20.0sp</item>
        <item name="android:typeface">normal</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/azulOscuro</item>
    </style>

    <style name="MyEditTextStyle" parent="@android:style/Widget.EditText">
        <item name="android:textSize">20.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#400000</item>
        <item name="android:background">@android:drawable/editbox_background_normal</item>
        <item name="android:padding">10.0dp</item>
    </style>

</resources>
